# Copia este archivo a .env y completa los valores.
# NUNCA subas un .env real al repositorio.

# --- Entorno ---
NODE_ENV=development
PORT=3000

# --- MongoDB Atlas ---
# Usa una cadena de conexión de Atlas (usuario + contraseña propios de Atlas).
MONGODB_URI=
# Opcional: DNS IPv4 para resolver SRV/TXT de Atlas si el DNS local no responde (p. ej. 1.1.1.1,1.0.0.1).
MONGODB_DNS_SERVERS=

# --- Seguridad / JWT ---
# Genera valores aleatorios largos, por ejemplo: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Duración del access token (segundos) y de la sesión refresh (días)
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14

# --- CORS ---
# Orígenes permitidos separados por coma (web y móvil en desarrollo)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
PLATFORM_ADMIN_EMAIL=

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10

# --- Seed inicial (npm run seed) ---
SEED_COMPANY_NAME=Empresa Demo
SEED_ADMIN_EMAIL=admin@demo.local
# Si lo dejas vacío, el seed genera una contraseña aleatoria y la imprime en consola.
SEED_ADMIN_PASSWORD=
